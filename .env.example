# ==========================================
# VisionPilot AI - Environment Configurations
# ==========================================

# --- API Server Port ---
# Railway dynamically assigns the PORT variable. For local dev, defaults to 8000.
PORT=8000

# --- Database Configurations ---
# Automatically set by Railway PostgreSQL integration.
# Schemes: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db>
# If DATABASE_URL is missing, local development will automatically fallback to SQLite.
DATABASE_URL=postgresql+asyncpg://visionpilot:visionpilot@localhost:5432/visionpilot_db
POSTGRES_USER=visionpilot
POSTGRES_PASSWORD=visionpilot
POSTGRES_DB=visionpilot_db

# --- Authentication & Encryption Secrets ---
# Use unique strong keys in production!
SECRET_KEY=SUPER_SECRET_VISION_PILOT_KEY_12345!
JWT_SECRET=SUPER_SECRET_VISION_PILOT_KEY_12345!

# --- Frontend Configurations ---
# Target backend API address connected by the React client.
# Development: http://localhost:8000
# Production: https://your-domain.up.railway.app
VITE_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:80
