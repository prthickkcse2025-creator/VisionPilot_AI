# Stage 1: Build React + Vite TS application
FROM node:20-alpine AS build

WORKDIR /app

# Copy package metadata files
COPY frontend/package.json ./

# Install npm dependencies
RUN npm install

# Copy frontend source
COPY frontend/ ./

# Compile typescript and build project bundle
RUN npm run build

# Stage 2: Serve static production assets with Nginx
FROM nginx:alpine

# Copy built artifacts from Stage 1 to Nginx default public path
COPY --from=build /app/dist /usr/share/nginx/html

# Copy default nginx configuration for routing React paths
COPY deployment/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
